# Copy to .env and fill in only the keys for the stages you intend to run.
# Nothing here is needed for `make all`, `make verify`, or any analysis that
# reads data/release/.
#
# .env is gitignored. No key belongs in a tracked file, and none is: this
# repository starts from a fresh history and a test fails the build if a
# credential pattern ever appears in a tracked file.

# Stage D, DeepSeek-R1 and Claude Sonnet 4.5 (Section 4.3).
OPENROUTER_API_KEY=
# Optional attribution header sent with OpenRouter calls.
OPENROUTER_REFERER=

# Stage D and Section 6, GPT-4o open-ended collection and multiple choice.
OPENAI_API_KEY=

# Appendix A7.3, collaborator lookups for the hardest distractor control.
# Optional: the public endpoint works without a key, but is rate limited hard.
S2_API_KEY=

# Section 3.1, Google search hit counts.
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=serp

# Section 3.2, Infini-gram. Optional; the public API needs no key.
INFINIGRAM_API_KEY=

# Section 7, model weights. Needed only to download gated checkpoints.
HF_TOKEN=
